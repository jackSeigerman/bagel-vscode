{
  "name": "bagel",
  "displayName": "Bagel",
  "description": "Bagel the pixel-art goldendoodle walks, sits, wags, lies down and naps in your sidebar.",
  "version": "0.0.1",
  "publisher": "jackseigerman",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackSeigerman/bagel-vscode.git"
  },
  "homepage": "https://github.com/jackSeigerman/bagel-vscode#readme",
  "bugs": {
    "url": "https://github.com/jackSeigerman/bagel-vscode/issues"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pet",
    "dog",
    "pixel art"
  ],
  "main": "./extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "bagel.view",
          "name": "Bagel",
          "icon": "images/bagel.svg"
        }
      ]
    }
  },
  "scripts": {
    "sync": "node scripts/sync-bagel.mjs",
    "icons": "node scripts/make-icons.mjs",
    "gif": "node scripts/make-gif.mjs",
    "package": "npx --yes @vscode/vsce@4 package --skip-license"
  }
}
